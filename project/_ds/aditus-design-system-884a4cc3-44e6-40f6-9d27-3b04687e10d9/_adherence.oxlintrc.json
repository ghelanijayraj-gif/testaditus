{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "assets/**",
              "assets/data/**",
              "components/brand/**",
              "components/cards/**",
              "components/content/**",
              "components/core/**",
              "components/forms/**",
              "components/navigation/**",
              "ui_kits/website/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Bowlby One|Space Mono|Archivo))/i]",
        "message": "Font not provided by the design system. Available: Bowlby One, Space Mono, Archivo."
      },
      {
        "selector": "JSXOpeningElement[name.name='AditusMark'] > JSXAttribute > JSXIdentifier[name!=/^(?:active|color|muted|size|onPick|style|key|ref|className|style|children)$/]",
        "message": "<AditusMark> doesn't accept that prop. Declared props: active, color, muted, size, onPick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='AditusMark'] > JSXAttribute[name.name='active'] > Literal[value!=/^(?:|movement|breathwork|recovery|performance)$/]",
        "message": "<AditusMark> active must be one of '' | 'movement' | 'breathwork' | 'recovery' | 'performance'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|href|onClick|disabled|full|children|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, href, onClick, disabled, full, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:ink|blue|outline|white|outline-light)$/]",
        "message": "<Button> variant must be one of 'ink' | 'blue' | 'outline' | 'white' | 'outline-light'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg|xl)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg' | 'xl'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CategoryBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|value|onChange|cartCount|onCart|key|ref|className|style|children)$/]",
        "message": "<CategoryBar> doesn't accept that prop. Declared props: items, value, onChange, cartCount, onCart."
      },
      {
        "selector": "JSXOpeningElement[name.name='CategoryCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|line|count|tone|href|caption|ratio|key|ref|className|style|children)$/]",
        "message": "<CategoryCard> doesn't accept that prop. Declared props: title, line, count, tone, href, caption, ratio."
      },
      {
        "selector": "JSXOpeningElement[name.name='CategoryCard'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:blue|ink|sky|ice|navy|periwinkle)$/]",
        "message": "<CategoryCard> tone must be one of 'blue' | 'ink' | 'sky' | 'ice' | 'navy' | 'periwinkle'."
      },
      {
        "selector": "JSXOpeningElement[name.name='EmailSignup'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|cta|done|onSubmit|key|ref|className|style|children)$/]",
        "message": "<EmailSignup> doesn't accept that prop. Declared props: tone, cta, done, onSubmit."
      },
      {
        "selector": "JSXOpeningElement[name.name='EmailSignup'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:dark|light)$/]",
        "message": "<EmailSignup> tone must be one of 'dark' | 'light'."
      },
      {
        "selector": "JSXOpeningElement[name.name='EventCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:date|time|title|place|req|href|key|ref|className|style|children)$/]",
        "message": "<EventCard> doesn't accept that prop. Declared props: date, time, title, place, req, href."
      },
      {
        "selector": "JSXOpeningElement[name.name='ImageSlot'] > JSXAttribute > JSXIdentifier[name!=/^(?:caption|src|tone|ratio|style|key|ref|className|style|children)$/]",
        "message": "<ImageSlot> doesn't accept that prop. Declared props: caption, src, tone, ratio, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ImageSlot'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:light|dark)$/]",
        "message": "<ImageSlot> tone must be one of 'light' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Label'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|display|children|style|key|ref|className|style|children)$/]",
        "message": "<Label> doesn't accept that prop. Declared props: tone, display, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Label'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:blue|ink|sky|ice|navy|periwinkle)$/]",
        "message": "<Label> tone must be one of 'blue' | 'ink' | 'sky' | 'ice' | 'navy' | 'periwinkle'."
      },
      {
        "selector": "JSXOpeningElement[name.name='OptionRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|desc|checked|multi|onClick|key|ref|className|style|children)$/]",
        "message": "<OptionRow> doesn't accept that prop. Declared props: label, desc, checked, multi, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='PathCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|line|tags|cta|href|caption|tone|minHeight|key|ref|className|style|children)$/]",
        "message": "<PathCard> doesn't accept that prop. Declared props: name, line, tags, cta, href, caption, tone, minHeight."
      },
      {
        "selector": "JSXOpeningElement[name.name='PathCard'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:white|blue)$/]",
        "message": "<PathCard> tone must be one of 'white' | 'blue'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Pill'] > JSXAttribute > JSXIdentifier[name!=/^(?:href|active|onClick|children|style|key|ref|className|style|children)$/]",
        "message": "<Pill> doesn't accept that prop. Declared props: href, active, onClick, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PracticeCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:type|tone|title|meta1|meta2|href|caption|ratio|key|ref|className|style|children)$/]",
        "message": "<PracticeCard> doesn't accept that prop. Declared props: type, tone, title, meta1, meta2, href, caption, ratio."
      },
      {
        "selector": "JSXOpeningElement[name.name='PracticeCard'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:blue|ink|sky|ice|navy|periwinkle)$/]",
        "message": "<PracticeCard> tone must be one of 'blue' | 'ink' | 'sky' | 'ice' | 'navy' | 'periwinkle'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProductCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|brand|type|price|tag|href|caption|actionLabel|onAction|key|ref|className|style|children)$/]",
        "message": "<ProductCard> doesn't accept that prop. Declared props: name, brand, type, price, tag, href, caption, actionLabel, onAction."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProgressBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|color|key|ref|className|style|children)$/]",
        "message": "<ProgressBar> doesn't accept that prop. Declared props: value, color."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|kicker|intro|link|href|size|tone|style|key|ref|className|style|children)$/]",
        "message": "<SectionHeader> doesn't accept that prop. Declared props: title, kicker, intro, link, href, size, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeader'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|lg|xl)$/]",
        "message": "<SectionHeader> size must be one of 'md' | 'lg' | 'xl'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeader'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:ink|light)$/]",
        "message": "<SectionHeader> tone must be one of 'ink' | 'light'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SiteFooter'] > JSXAttribute > JSXIdentifier[name!=/^(?:onNavigate|key|ref|className|style|children)$/]",
        "message": "<SiteFooter> doesn't accept that prop. Declared props: onNavigate."
      },
      {
        "selector": "JSXOpeningElement[name.name='SiteNav'] > JSXAttribute > JSXIdentifier[name!=/^(?:active|cta|cartCount|onNavigate|defaultOpen|overlay|key|ref|className|style|children)$/]",
        "message": "<SiteNav> doesn't accept that prop. Declared props: active, cta, cartCount, onNavigate, defaultOpen, overlay."
      },
      {
        "selector": "JSXOpeningElement[name.name='SiteNav'] > JSXAttribute[name.name='active'] > Literal[value!=/^(?:|training|shop|library|community|about)$/]",
        "message": "<SiteNav> active must be one of '' | 'training' | 'shop' | 'library' | 'community' | 'about'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SiteNav'] > JSXAttribute[name.name='overlay'] > Literal[value!=/^(?:fixed|absolute)$/]",
        "message": "<SiteNav> overlay must be one of 'fixed' | 'absolute'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SpecList'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|key|ref|className|style|children)$/]",
        "message": "<SpecList> doesn't accept that prop. Declared props: items."
      },
      {
        "selector": "JSXOpeningElement[name.name='StepList'] > JSXAttribute > JSXIdentifier[name!=/^(?:steps|key|ref|className|style|children)$/]",
        "message": "<StepList> doesn't accept that prop. Declared props: steps."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|size|children|style|key|ref|className|style|children)$/]",
        "message": "<Tag> doesn't accept that prop. Declared props: tone, size, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:ink|light)$/]",
        "message": "<Tag> tone must be one of 'ink' | 'light'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|lg)$/]",
        "message": "<Tag> size must be one of 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextLink'] > JSXAttribute > JSXIdentifier[name!=/^(?:href|display|tone|children|style|key|ref|className|style|children)$/]",
        "message": "<TextLink> doesn't accept that prop. Declared props: href, display, tone, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextLink'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:ink|light|sky)$/]",
        "message": "<TextLink> tone must be one of 'ink' | 'light' | 'sky'."
      },
      {
        "selector": "JSXOpeningElement[name.name='VariantSelector'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|options|value|onChange|key|ref|className|style|children)$/]",
        "message": "<VariantSelector> doesn't accept that prop. Declared props: label, options, value, onChange."
      }
    ]
  },
