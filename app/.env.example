DATABASE_URL="postgresql://aditus:aditus@localhost:5432/aditus"
# Separate secrets per interface so a client cookie can never decode as a staff cookie.
AUTH_SECRET_CLIENT="dev-client-secret-change-me-0123456789abcdef"
AUTH_SECRET_STAFF="dev-staff-secret-change-me-0123456789abcdef"
AUTH_TRUST_HOST=true
# Optional: enable Google Workspace sign in for staff
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
# STAFF_GOOGLE_WORKSPACE_DOMAIN=aditus.in
# Show the dev quick sign in pickers (never in production)
DEV_AUTH=1
# Today's date for the sample data (the designs are set on Wed 7 Oct 2026). Remove to use the real clock.
APP_NOW="2026-10-07T19:52:00+05:30"
